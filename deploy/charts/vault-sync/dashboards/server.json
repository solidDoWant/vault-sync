      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(vault_sync_retention_revisions_purged_total{namespace=\"$namespace\", job=\"$job\", pod=~\"$pod\"}[1h]))",
          "legendFormat": "revisions purged",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(vault_sync_retention_blobs_collected_total{namespace=\"$namespace\", job=\"$job\", pod=~\"$pod\"}[1h]))",
