--- /dev/null
+++ 2/plugin/test/e2e/specs/status-screenshots.e2e.ts
@@ -0,0 +1,104 @@
+import { createHash } from "node:crypto";
+import path from "node:path";
+
+import { browser } from "@wdio/globals";
+
+import { syncStatus, writeNote } from "../devices";
+import { e2eEnvironment, pluginId } from "../environment";
+import { callHarness } from "../obsidian";
+import { configure, signInAs } from "../signin";
+
+// Screenshots of the sync status details (the notice "Show sync status"
+// opens; on mobile also the ribbon icon) in each state, for a review on a
+// phone-sized screen. Runs only when VAULT_SYNC_E2E_SCREENSHOTS_DIR names the
+// output directory. It checks nothing: it only takes pictures. Every state is
+// set up through the harness; nothing edits the page.
+
+const outputDir = process.env.VAULT_SYNC_E2E_SCREENSHOTS_DIR ?? "";
+const subject = "plugin-e2e-status-screenshots-user";
+
+type Status = NonNullable<Awaited<ReturnType<typeof syncStatus>>>;
+
+async function waitForStatus(check: (status: Status) => boolean, what: string) {
+  let last: Status | null = null;
+  await browser
+    .waitUntil(async () => (last = await syncStatus()) !== null && check(last), { timeout: 90_000, interval: 250 })
+    .catch(() => {
+      throw new Error(`${what}; last status: ${JSON.stringify(last)}`);
+    });
+}
+
+async function noNotices() {
+  await browser.waitUntil(() => browser.execute(() => document.querySelectorAll(".notice").length === 0), { timeout: 30_000, interval: 250, timeoutMsg: "notices never closed" });
+}
+
+/** Opens the status details the way the user does (the command; the ribbon icon runs the same) and saves a screenshot. */
+async function capture(name: string) {
+  await noNotices();
+  await browser.executeObsidian(({ app }, id) => {
+    (app as unknown as { commands: { executeCommandById(command: string): boolean } }).commands.executeCommandById(`${id}:show-status`);
+  }, pluginId);
+  await browser.pause(700);
+  await browser.saveScreenshot(path.join(outputDir, `${name}.png`));
+  const status = await syncStatus();
+  console.log(`status-screenshot ${name}: ${JSON.stringify(status)}`);
+}
+
+describe("sync status screenshots", function () {
+  before(function () {
+    if (outputDir === "") this.skip();
+  });
+
+  it("captures the status details while idle, offline with local changes, and pulling with incoming changes", async function () {
+    await configure();
+    if ((await signInAs(subject)) !== true) throw new Error("sign-in failed");
+    await browser.executeObsidian(async ({ app }, id) => {
+      const target = (app as unknown as { plugins: { plugins: Record<string, { createRemoteVault(name: string): Promise<unknown>; connectVault(vault: unknown): Promise<string> }> } }).plugins.plugins[id];
+      if (target === undefined) throw new Error("vault-sync is not loaded");
+      const vault = await target.createRemoteVault("Notes");
+      if ((await target.connectVault(vault)) !== "connected") throw new Error("the new vault was not connected");
+    }, pluginId);
+
+    await writeNote("Plan.md", "# Plan\n\n- pack\n");
+    await writeNote("Ideas.md", "# Ideas\n");
+    await writeNote("Reading list.md", "# Reading list\n");
+    await waitForStatus((status) => status.state === "idle" && status.pending === 0, "sync never became idle");
+    await capture("status-1-idle");
+
+    // Offline: the server can't be reached, and local edits wait.
+    await callHarness("installServerSwitch");
+    await waitForStatus((status) => status.state === "idle", "sync was not idle after the switch");
+    await callHarness("setServerReachable", false);
+    await writeNote("Plan.md", "# Plan\n\n- pack\n- book the train\n");
+    await writeNote("Draft.md", "A draft written on the train.\n");
+    await writeNote("Recipes/Soup.md", "# Soup\n");
+    await waitForStatus((status) => status.state === "offline" && (status.pendingFiles?.length ?? 0) >= 3, "the status never went offline with the local changes");
+    await capture("status-2-offline-local-changes");
+
+    // Another device changes files, Plan.md among them; this device then
+    // reaches the server again and its pull stops at one download.
+    const serverUrl = e2eEnvironment.serverUrl;
+    for (const note of ["Inbox/Call the bank.md", "Inbox/Groceries.md", "Inbox/Birthday.md"]) await callHarness("commitFromAnotherDevice", note, `${note} from the laptop\n`, serverUrl);
+    const held = "Meeting notes.md";
+    const heldText = "# Meeting notes\n\nfrom the laptop\n";
+    await callHarness("commitFromAnotherDevice", held, heldText, serverUrl);
+    for (const note of ["Journal/2026-11-23.md", "Journal/2026-11-24.md", "Photos to sort.md"]) await callHarness("commitFromAnotherDevice", note, `${note} from the laptop\n`, serverUrl);
+    await callHarness("commitEditFromAnotherDevice", "Plan.md", "# Plan\n\n- pack\n- buy the tickets\n", serverUrl);
+    await callHarness("holdAllDownloadsOfThenReconnect", createHash("sha256").update(heldText).digest("hex"));
+    await waitForStatus(
+      (status) => status.state === "syncing" && (status.incoming?.length ?? 0) > 0 && status.progress !== undefined && status.progress.done >= 3,
+      "the pull never stopped at the held download",
+    );
+    // Lets the status settle (it is reported at most every 250 ms).
+    await browser.pause(1500);
+    await capture("status-3-syncing-incoming");
+
+    // The ribbon icon (mobile has no status bar): the left sidebar open.
+    await noNotices();
+    await browser.executeObsidian(({ app }) => {
+      (app as unknown as { workspace: { leftSplit: { expand(): void } } }).workspace.leftSplit.expand();
+    });
+    await browser.pause(1000);
+    await browser.saveScreenshot(path.join(outputDir, "status-4-ribbon-icon.png"));
+  });
+});
