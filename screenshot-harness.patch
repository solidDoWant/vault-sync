+  /**
+   * Commits a new revision of the note at `path` with `text`, as another
+   * device of the signed-in user would, over `serverUrl` (past the server
+   * switch): the status screenshots use it for a change made on both sides.
+   */
+  async commitEditFromAnotherDevice(path: string, text: string, serverUrl: string): Promise<void> {
+    const plugin = this.vaultSync();
+    const vaultId = plugin.connectedVault?.id;
+    if (vaultId === undefined) throw new Error("vault-sync is not connected");
+    const client = this.clientAt(plugin, serverUrl);
+    let head: { documentId: string; revisionId: string } | undefined;
+    for (let sinceSeq = 0n; ; ) {
+      const page = await client.sync.listChanges({ vaultId, sinceSeq });
+      for (const revision of page.revisions) {
+        sinceSeq = revision.seq;
+        if (decoder.decode(revision.path) === path) head = { documentId: revision.documentId, revisionId: revision.id };
+      }
+      if (!page.hasMore) break;
+    }
+    if (head === undefined) throw new Error(`no document at ${path} on the server`);
+    this.otherDeviceId ??= (await client.devices.registerDevice({ name: "e2e other device" })).device?.id;
+    if (this.otherDeviceId === undefined) throw new Error("the server registered no device");
+    const content = encoder.encode(text);
+    const blobId = hexToBytes(sha256Hex(content));
+    const size = BigInt(content.length);
+    await client.blobs.beginBlob({ vaultId, blobId, size });
+    await client.blobs.putBlobChunk({ vaultId, blobId, offset: 0n, data: content });
+    await client.blobs.commitBlob({ vaultId, blobId });
+    await client.sync.commitRevision({
+      vaultId,
+      documentId: head.documentId,
+      revisionId: uuidv7(),
+      baseRevId: head.revisionId,
+      kind: DocumentKind.TEXT,
+      contentRef: { blobId, size },
+      path: encoder.encode(path),
+      deviceId: this.otherDeviceId,
+    });
+  }
+
+  /**
+   * Holds every DownloadBlob call for the blob `blobIdHex`, from its first
+   * range, then makes the server reachable and restarts vault-sync's sync
+   * session in the same task, so the new session's first pull stops at that
+   * blob with the rest of the pull learned (status screenshots).
+   */
+  async holdAllDownloadsOfThenReconnect(blobIdHex: string): Promise<void> {
+    const plugin = this.vaultSync();
+    const original = plugin.protocolClient.bind(plugin);
+    plugin.protocolClient = () => {
+      const client = original();
+      const blobs = client.blobs;
+      return {
+        ...client,
+        blobs: {
+          ...blobs,
+          downloadBlob: async (request, options) => {
+            if (bytesToHex(request.blobId ?? new Uint8Array()) === blobIdHex) return await new Promise<never>(() => undefined);
+            return await blobs.downloadBlob(request, options);
+          },
+        },
+      };
+    };
+    const controller = (plugin as unknown as { controller?: { stop(): Promise<void>; restart(): Promise<void> } }).controller;
+    if (controller === undefined) throw new Error("vault-sync has no sync controller");
+    await controller.stop();
+    this.serverReachable = true;
+    void controller.restart();
+  }
+
