{
  "name": "vault-sync-plugin",
  "version": "0.3.0",
  "private": true,
  "description": "Obsidian plugin for vault-sync",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/e2e && node scripts/check-core-program.ts"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wdio-obsidian-reporter": "^3.3.0",
    "wdio-obsidian-service": "^3.3.0",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.5.4",
    "@scure/base": "^2.4.0",
    "@unicode/unicode-15.0.0": "2.1.0",
    "age-encryption": "^0.3.1",
    "diff-match-patch": "^1.0.5",
    "hash-wasm": "^4.12.0",
    "oauth4webapi": "^3.8.8",
    "unicode-case-folding": "1.1.2",
    "uuid": "^14.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
