{
  "name": "vault-sync-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "Obsidian plugin for vault-sync",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "obsidian": "^1.14.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@noble/hashes": "^2.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
