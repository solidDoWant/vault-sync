{
  "description": "Shared vault-relative path validity vectors (SPEC.md section 6.2). Both \"/\" and \"\\\" are separators. A path is valid only if it does not start with a separator (which also rules out UNC, \\\\?\\ and \\\\.\\ prefixes), does not start with a drive letter followed by a colon (C:, C:x, C:\\x, C:/x), and has no segment that is empty or made only of dots and spaces (., .., and forms such as '.. ' or '...' that Windows normalizes to them). Names that are merely unmaterializable on Windows (reserved device names, colons elsewhere, trailing dots or spaces) are valid. Both internal/vaultpath (Go) and plugin/src/core/vaultpath (TypeScript) must return valid exactly as given for every vector. Length and character-set limits are checked separately and are not covered here.",
  "vectors": [
    { "name": "single file", "path": "a.md", "valid": true },
    { "name": "nested file", "path": "notes/daily/2026-10-18.md", "valid": true },
    { "name": "backslash-separated nested file", "path": "notes\\daily.md", "valid": true },
    { "name": "mixed separators", "path": "notes\\daily/a.md", "valid": true },
    { "name": "dot file", "path": ".obsidian/app.json", "valid": true },
    { "name": "name starting with two dots", "path": "..md", "valid": true },
    { "name": "name with dots inside", "path": "a..b.md", "valid": true },
    { "name": "reserved device name", "path": "CON.md", "valid": true },
    { "name": "reserved device name without extension", "path": "notes/NUL", "valid": true },
    { "name": "colon after more than one letter", "path": "ab:c.md", "valid": true },
    { "name": "drive-like name in a later segment", "path": "notes/a:b.md", "valid": true },
    { "name": "drive-like directory in a later segment", "path": "notes/C:/x.md", "valid": true },
    { "name": "digit followed by colon", "path": "1:x.md", "valid": true },
    { "name": "trailing dot", "path": "notes/a.", "valid": true },
    { "name": "trailing space", "path": "notes/a ", "valid": true },
    { "name": "leading space", "path": " a.md", "valid": true },
    { "name": "question mark in name", "path": "why?.md", "valid": true },

    { "name": "empty path", "path": "", "valid": false },
    { "name": "single dot", "path": ".", "valid": false },
    { "name": "single dot-dot", "path": "..", "valid": false },
    { "name": "leading slash", "path": "/abs.md", "valid": false },
    { "name": "leading backslash", "path": "\\abs.md", "valid": false },
    { "name": "trailing slash", "path": "notes/", "valid": false },
    { "name": "trailing backslash", "path": "notes\\", "valid": false },
    { "name": "empty segment with slashes", "path": "notes//a.md", "valid": false },
    { "name": "empty segment with backslashes", "path": "notes\\\\a.md", "valid": false },
    { "name": "empty segment with mixed separators", "path": "notes/\\a.md", "valid": false },
    { "name": "dot segment with slashes", "path": "notes/./a.md", "valid": false },
    { "name": "dot segment with backslashes", "path": "notes\\.\\a.md", "valid": false },
    { "name": "dot-dot segment with slashes", "path": "a/../b.md", "valid": false },
    { "name": "issue 139: leading backslash dot-dot segments", "path": "..\\..\\..\\evil.md", "valid": false },
    { "name": "issue 139: backslash dot-dot inside", "path": "notes\\..\\..\\outside.md", "valid": false },
    { "name": "backslash dot-dot once", "path": "..\\x.md", "valid": false },
    { "name": "backslash dot-dot after a directory", "path": "a\\..\\..\\x.md", "valid": false },
    { "name": "trailing backslash dot-dot", "path": "notes\\..", "valid": false },
    { "name": "mixed separators around dot-dot", "path": "notes/..\\x.md", "valid": false },
    { "name": "dot-dot with a trailing space", "path": "notes/.. /x.md", "valid": false },
    { "name": "dot-dot with a trailing dot", "path": "notes\\...\\x.md", "valid": false },
    { "name": "dot with a trailing space", "path": ". \\x.md", "valid": false },
    { "name": "only spaces and dots", "path": "a/ . /b.md", "valid": false },
    { "name": "only spaces", "path": "a/   /b.md", "valid": false },
    { "name": "issue 139: drive letter with backslash", "path": "C:\\Windows\\evil.md", "valid": false },
    { "name": "issue 139: drive letter with slash", "path": "C:/evil.md", "valid": false },
    { "name": "bare drive letter", "path": "C:", "valid": false },
    { "name": "lower-case drive letter", "path": "c:\\x.md", "valid": false },
    { "name": "drive-relative path", "path": "C:x.md", "valid": false },
    { "name": "drive-relative single-letter name", "path": "a:b.md", "valid": false },
    { "name": "issue 139: UNC prefix", "path": "\\\\server\\share\\evil.md", "valid": false },
    { "name": "UNC prefix with slashes", "path": "//server/share/evil.md", "valid": false },
    { "name": "Win32 file namespace prefix", "path": "\\\\?\\C:\\evil.md", "valid": false },
    { "name": "Win32 device namespace prefix", "path": "\\\\.\\PhysicalDrive0", "valid": false },
    { "name": "device namespace prefix with slashes", "path": "//./pipe/x", "valid": false }
  ]
}
