    { "name": "backslash-separated nested file", "path": "notes\\daily.md", "valid": true, "new": false },
    { "name": "mixed separators", "path": "notes\\daily/a.md", "valid": true, "new": false },
    { "name": "issue 191: backslash where another path has a slash", "path": "a\\b", "valid": true, "new": false },
