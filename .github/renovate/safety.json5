{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "Approval gates, version holds and reminders for what Renovate can't regenerate",
  packageRules: [
    // First: later rules match on the overridden (docker.io/...) name.
    {
      description: "mirror.gcr.io lists only cached tags; look up Docker Hub (same digests)",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^mirror\\.gcr\\.io//"],
      overridePackageName: "{{{replace '^mirror\\.gcr\\.io/' 'docker.io/' packageName}}}",
    },
    {
      description: "Major updates wait for a Dependency Dashboard checkbox",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "The PostgreSQL 14 test override exercises the minimum supported version (docs/testing/integration.md); only minor and digest updates apply",
      matchFileNames: ["deploy/compose/compose.test-postgres14.yaml"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "No digest pins: flake.lock already pins nixpkgs, and a preset ref can't carry both tag and SHA",
      matchManagers: ["nix", "renovate-config"],
      pinDigests: false,
    },
    {
      description: "The Go toolchain comes from nixpkgs (flake.lock); a go/toolchain bump past it breaks the Nix build",
      matchManagers: ["gomod"],
      matchDepTypes: ["golang", "toolchain"],
      enabled: false,
    },
    // Majors held until their ecosystem supports them. Remove a rule once
    // its condition holds.
    {
      description: "TypeScript 7: held until typescript-eslint supports it (its typescript peer range stops below 7)",
      matchPackageNames: ["typescript"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "WebdriverIO 10: held until wdio-obsidian-service and wdio-obsidian-reporter support it (both depend on WebdriverIO 9)",
      matchPackageNames: ["webdriverio", "@wdio/**"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "connect-go v2: a separate migration (new module path, generated-code and handler-signature changes), not a version bump",
      matchPackageNames: ["connectrpc.com/connect"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Generator/runtime bumps change generated code",
      matchPackageNames: ["@bufbuild/**", "@connectrpc/**", "google.golang.org/protobuf", "connectrpc.com/connect"],
      prBodyNotes: ["⚠️ Run `make generate` and commit the result before merging (CI's check-generate step fails otherwise)."],
    },
  ],
}
